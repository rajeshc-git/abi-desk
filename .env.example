###############################################################################
# ABI Desk - environment configuration
#
#   cp .env.example .env
#
# Two audiences read this file:
#   1. docker compose, which composes container-internal URLs from the
#      credential pieces below (POSTGRES_*, MINIO_*),
#   2. host-side tooling (prisma migrate / studio / seed, pnpm dev), which uses
#      the localhost URLs further down.
#
# The values shipped here are development defaults. Rotate every secret before
# any deployment that is reachable by someone other than you.
###############################################################################

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=debug
# Human-readable console logs. Set to false to emit JSON (what you want in prod).
LOG_PRETTY=true

# ---------------------------------------------------------------------------
# PostgreSQL
#
# Three roles, on purpose:
#   superuser -> container bootstrap only
#   owner     -> owns the schema, used by Prisma Migrate (bypasses RLS)
#   app       -> used by the API/worker at runtime (Row Level Security applies)
# ---------------------------------------------------------------------------
POSTGRES_DB=abidesk
POSTGRES_PORT=5432

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev_superuser_pw_change_me

POSTGRES_OWNER_USER=abidesk_owner
POSTGRES_OWNER_PASSWORD=dev_owner_pw_change_me

POSTGRES_APP_USER=abidesk_app
POSTGRES_APP_PASSWORD=dev_app_pw_change_me

# Host-side connection strings (localhost). Containers build their own from the
# credentials above - do not point these at the `postgres` hostname.
DATABASE_URL=postgresql://abidesk_app:dev_app_pw_change_me@localhost:5432/abidesk?schema=public
MIGRATION_DATABASE_URL=postgresql://abidesk_owner:dev_owner_pw_change_me@localhost:5432/abidesk?schema=public
# Logs every SQL statement with timing. Extremely verbose; debugging only.
DATABASE_LOG_QUERIES=false

# ---------------------------------------------------------------------------
# Redis - queues, realtime pub/sub, rate limiting
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Object storage (MinIO locally, any S3 API in production)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=abidesk
MINIO_ROOT_PASSWORD=dev_minio_pw_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
# Endpoint used to SIGN browser-facing URLs. The API reaches MinIO privately
# (http://minio:9000 inside compose); a browser cannot resolve that name, and a
# presigned URL's host is part of its signature. Leave unset when both are the same.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=abi-desk-media
S3_ACCESS_KEY_ID=abidesk
S3_SECRET_ACCESS_KEY=dev_minio_pw_change_me
# MinIO requires path-style addressing; set false for real AWS S3.
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Outbound mail (Mailpit locally - inbox at http://localhost:8025)
# ---------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ABI Desk <no-reply@abidesk.local>

# ---------------------------------------------------------------------------
# HTTP
#
# CORS_ORIGINS must list exact origins: credentialed requests cannot use `*`.
#   3000 -> agent console (Next.js)
#   5173 -> widget dev server (Vite)
#   8080 -> demo host application
# ---------------------------------------------------------------------------
API_PORT=4000
PORT=4000
HOST=0.0.0.0
API_PREFIX=api
TRUST_PROXY=true
HTTP_BODY_LIMIT_BYTES=2097152
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:9999,http://192.168.10.246:9999
CONSOLE_URL=http://192.168.10.246:9999

# ---------------------------------------------------------------------------
# Cryptography
#
# APP_ENCRYPTION_KEY encrypts secrets that must be recoverable, not just
# comparable: widget handoff signing secrets, SSO client secrets, webhook signing
# secrets, integration tokens, TOTP seeds. AES-256-GCM, so it must decode to
# exactly 32 bytes.
#
# Passwords and API keys are NOT encrypted with it - those are Argon2id hashes,
# because the platform only ever needs to compare them.
#
#   openssl rand -base64 32
#
# Rotating this key without re-encrypting existing rows makes every stored secret
# unreadable. Treat it as the most sensitive value in this file.
# ---------------------------------------------------------------------------
APP_ENCRYPTION_KEY=N1pOsr5pRP0Lfgx4ez1nejUVNgp/N2VGNReIHp+AY8s=

# JWT signing keys. Separate secrets for access and refresh tokens so a leaked
# access secret cannot be used to mint refresh tokens.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=J6fPj0NIN2JXO7fZrvm0ykPuP2joi4Cyi6oKe9KduZWaGIFsWuvcCdlFKCGLCPyn
JWT_REFRESH_SECRET=Fn3wT31wjdIGHSC3DqerW/F2/Ndm7ca5/TANv2LylRLaROHtUY/XiFb23i+PRrJJ
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=abi-desk

# ---------------------------------------------------------------------------
# Operational tuning
# ---------------------------------------------------------------------------
HEALTH_PROBE_TIMEOUT_MS=2000
SHUTDOWN_GRACE_MS=10000

# Seed demo data (2 tenants, all roles, sample tickets) on API container start.
RUN_SEED=false

# ---------------------------------------------------------------------------
# Inbound Email Webhook Secret (CloudMailin / SendGrid webhook verification)
# ---------------------------------------------------------------------------
INBOUND_EMAIL_SECRET=your_inbound_webhook_secret_here

