{
  "name": "@abi-desk/widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embeddable customer support widget with screenshot annotation, screen recording, voice notes, and diagnostics capture for ABI Desk",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node bundle.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --declaration false --declarationMap false",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "esbuild": "^0.25.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
