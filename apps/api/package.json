{
  "name": "@abi-desk/api",
  "version": "0.1.0",
  "private": true,
  "description": "ABI Desk API and background worker (NestJS 11 on Fastify)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --declaration false --declarationMap false",
    "lint": "eslint src",
    "start": "node dist/main.js",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "dev:worker": "cross-env PROCESS_ROLE=worker tsx watch --clear-screen=false src/main.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.mts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@abi-desk/db": "workspace:*",
    "@abi-desk/rbac": "workspace:*",
    "@aws-sdk/client-s3": "3.1105.0",
    "@aws-sdk/s3-request-presigner": "3.1105.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "8.1.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.28",
    "@node-rs/argon2": "2.0.2",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "6.0.9",
    "fastify": "5.11.2",
    "file-type": "22.0.1",
    "ioredis": "6.0.0",
    "jose": "6.2.8",
    "luxon": "3.7.2",
    "nestjs-pino": "4.6.1",
    "nodemailer": "9.0.4",
    "openid-client": "6.8.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@swc/core": "1.15.47",
    "@types/luxon": "3.7.4",
    "@types/node": "22.20.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.21.0",
    "@types/supertest": "7.2.1",
    "dotenv-cli": "11.0.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "tsx": "4.23.10",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.10",
    "vitest": "4.1.10"
  }
}
