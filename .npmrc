# Pin exact dependency versions - enterprise builds should be byte-reproducible.
save-exact=true

# Workspace packages are linked, never fetched from a registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Peer dependency handling: install them, but do not fail the install on a
# mismatch we have consciously accepted.
auto-install-peers=true
strict-peer-dependencies=false

# Keep the store hoisting predictable for Docker layer caching.
resolution-mode=highest
